# Copier ce fichier en ".env" et remplir les valeurs
# Le fichier ".env" ne doit JAMAIS être commité (voir .gitignore)

# Clé API Google — activer "Places API (New)" et restreindre la clé à cette
# seule API dans Google Cloud Console. (Appel côté serveur : la restriction
# "referrer HTTP" ne s'applique pas ; restreindre par API suffit.)
GOOGLE_PLACES_API_KEY=your_google_api_key_here

# Nom de l'établissement à rechercher sur Google Maps
GOOGLE_PLACE_QUERY=Dugos Photographe Marmande

# (Optionnel mais recommandé) Place ID Google — le script l'affiche à la fin
# de sa 1re exécution. Le renseigner ici évite la recherche texte (plus fiable,
# moins d'appels facturés) et fiabilise le lien "laisser un avis".
GOOGLE_PLACE_ID=
